{
  "name": "incident",
  "private": true,
  "scripts": {
    "prepare": "husky",
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types"
  },
  "devDependencies": {
    "husky": "9.1.7",
    "prettier": "3.9.6",
    "turbo": "^2.11.13",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=24"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.2.3"
    }
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "tooling/*"
  ]
}
